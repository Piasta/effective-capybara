<mvc:View controllerName="project1.controller.View1"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:table="sap.ui.table"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="page" title="{i18n>title}">
        <VBox>
            <fb:FilterBar id="filterbar" persistencyKey="employeeFilterKey" useToolbar="false" filterChange="onFilterChange">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem name="Name" label="Imię" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idNameInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="LastName" label="Nazwisko" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idLastNameInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="Position" label="Stanowisko" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idPositionInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
            <Table id="table" items="{path:'Employees>/Employees', sorter: {path: 'FirstName'}}" mode="SingleSelectLeft"  itemPress="onEmployeePress" selectionChange="onItemSelected">
                <headerToolbar>
                    <OverflowToolbar id="otbSubheader">
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://add" text="Dodaj pracownika" tooltip="Add Employee" press="onAddEmployee" />
                        <Button id="removeEmployeeBtn" icon="sap-icon://delete" text="Usuń pracownika" tooltip="Remove Employee" press="onDeleteEmployee" enabled="false" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="{i18n>nameColumnTxt}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>lastNameColumnTxt}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>positionColumnTxt}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <Text text="{Employees>FirstName}" />
                            <Text text="{Employees>LastName}" />
                            <Text text="{Employees>Position}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
