<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:smartForm="sap.ui.comp.smartform" xmlns:smartField="sap.ui.comp.smartfield">
    <Dialog title="Add Employee" class="sapUiResponsivePadding" contentWidth="25rem">
        <content>
            <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">
                <Label text="Imię" required="true" />
                <Input id="firstNameInput" placeholder="Imię"  />

                <Label text="Nazwisko" required="true" />
                <Input id="lastNameInput"/>

                <Label text="Stanowisko" required="true"/>
                <Input id="positionInput"/>

                <Label text="Email" type="Email" />
                <Input id="emailInput" liveChange="onInputLiveChange"/>

                <Label text="Telefon" />
                <Input id="phoneInput" placeholder="123-456-789" liveChange="onInputLiveChange" />
            </VBox>
        </content>
        <buttons>
            <Button text="Zapisz" type="Emphasized" press="onSaveEmployee"/>
            <Button text="Anuluj" press="onCancelEmployee"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>