<mvc:View controllerName="project1.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    
    <VBox class="sapUiSmallMargin">
        <Button 
            text="Cofnij"
            press="onBackPress"
            icon="sap-icon://nav-back"
            type="Transparent"
            class="sapUiSmallMarginTop" />
        
        <Button 
            text="Edytuj"
            press="onEditPress"
            visible="true"
            type="Emphasized"
            class="sapUiSmallMarginTop" />
        
        <Panel headerText="{i18n>employeeDetails}" class="sapUiSmallMarginTop" expandable="false">
            <HBox>
                <Avatar class="sapUiSmallMarginEnd" initials="IS" />
                
                <VBox class="sapUiMediumMarginEnd">
                    <!-- Imię -->
                    <Text text="Imię: " />
                    <Input value="{employeeModel>/FirstName}" editable="{=${editModel>/editMode} }"/>

                    <!-- Nazwisko -->
                    <Text text="Nazwisko: " />
                    <Input value="{employeeModel>/LastName}" editable="{=${editModel>/editMode} }"/>

                    <!-- Stanowisko -->
                    <Text text="Stanowisko: " />
                    <Input value="{employeeModel>/Position}" editable="{=${editModel>/editMode} }"/>
                </VBox>
                
                <VBox>
                    <!-- Email -->
                    <Text text="Email: " />
                    <Input value="{employeeModel>/Email}" type="Email" editable="{=${editModel>/editMode} }"/>

                    <!-- Numer telefonu -->
                    <Text text="Telefon: " />
                    <Input value="{employeeModel>/Phone}" type="Tel" editable="{=${editModel>/editMode} }"/>
                </VBox>
            </HBox>
        </Panel>

        <Panel headerText="Opis stanowiska" class="sapUiSmallMarginTop" expandable="false">
            <Input value="{employeeModel>/Description}" editable="{=${editModel>/editMode} }"/>
        </Panel>

        <!-- Przycisk Save oraz Cancel w trybie edycji -->
        <HBox visible="{${editModel>/editMode}}">
            <Button text="Zapisz" press="onSavePress"/>
            <Button text="Anuluj" press="onCancelPress"/>
        </HBox>
    </VBox>
    
</mvc:View>
